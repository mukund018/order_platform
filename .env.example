# Copy to .env before running docker compose.

# shared
LOG_LEVEL=INFO
LOG_DIR=/app/logs
DEBUG_ATTACH=0

# databases
POSTGRES_USER=app
POSTGRES_PASSWORD=app
ORDERS_DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/orders_db
INVENTORY_DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/inventory_db
PAYMENTS_DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/payments_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# redis / celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
PRODUCT_CACHE_TTL=60

# service URLs + timeouts
INVENTORY_URL=http://inventory:8002
PAYMENTS_URL=http://payments:8003
INVENTORY_TIMEOUT_S=2.0
PAYMENTS_TIMEOUT_S=3.0

# business rules
ORDER_EXPIRY_MINUTES=15
BUSINESS_TIMEZONE=Asia/Kolkata

# simulated gateway
GATEWAY_LATENCY_MS_MIN=50
GATEWAY_LATENCY_MS_MAX=300
GATEWAY_FAILURE_RATE=0.05
GATEWAY_TIMEOUT_RATE=0.0
# how long "timeout mode" hangs for; keep it above PAYMENTS_TIMEOUT_S
GATEWAY_TIMEOUT_SLEEP_S=30.0
# set to an integer to make gateway declines reproducible; leave unset for random
# GATEWAY_SEED=

# inventory
# one prometheus time series per product would be too many, so only these get a
# product_stock gauge
TRACKED_SKUS=SKU-0001,SKU-0002,SKU-0003,SKU-0004,SKU-0005

# celery worker
# the worker has no HTTP API, so it serves prometheus on this port for scraping
METRICS_PORT=9100

# grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# host ports used by tools/ run outside docker
ORDERS_PUBLIC_URL=http://localhost:8001
INVENTORY_PUBLIC_URL=http://localhost:8002
PAYMENTS_PUBLIC_URL=http://localhost:8003
